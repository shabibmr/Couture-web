# ========================================
# BACKEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env files with real credentials

# ----------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------
PORT=5000
NODE_ENV=development

# ----------------------------------------
# DATABASE CONFIGURATION (MySQL)
# ----------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=couture_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# ----------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_change_in_production

# ----------------------------------------
# FIREBASE ADMIN SDK
# ----------------------------------------
# Project ID from Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Admin SDK Service Account JSON (stringified)
# Get from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Use: JSON.stringify() to convert the JSON file to a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ----------------------------------------
# RAZORPAY PAYMENT GATEWAY
# ----------------------------------------
# Set to 'test' for development, 'live' for production
RAZORPAY_MODE=test

# TEST MODE CREDENTIALS (for development/testing)
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=your_test_key_secret
RAZORPAY_TEST_WEBHOOK_SECRET=your_test_webhook_secret

# LIVE MODE CREDENTIALS (for production only - keep secure!)
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=your_live_key_secret
RAZORPAY_LIVE_WEBHOOK_SECRET=your_live_webhook_secret

# ----------------------------------------
# CORS & FRONTEND URLS
# ----------------------------------------
# Customer-facing storefront URL
FRONTEND_URL=http://localhost:5173

# Admin dashboard URL
ADMIN_URL=http://localhost:5174

# Backend API URL (used for webhooks, callbacks)
API_URL=http://localhost:5000

# ----------------------------------------
# EMAIL CONFIGURATION (SMTP)
# ----------------------------------------
# For order confirmations, password resets, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
